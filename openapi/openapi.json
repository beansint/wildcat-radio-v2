  "info": {
    "title": "Wildcat Radio v2 API",
    "description": "Control plane — see docs/final-build-plan/03-API-CONTRACT.md",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "StudioEpisodeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "showId": {
            "type": "string",
            "nullable": true
          },
          "unscheduled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status",
          "startedAt",
          "endedAt",
          "showId",
          "unscheduled"
        ]
      },
      "StudioAttendeeDto": {
        "type": "object",
        "properties": {
          "rosterId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "timeIn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "rosterId",
          "displayName",
          "timeIn"
        ]
      },
      "StudioSlotRosterEntryDto": {
        "type": "object",
        "properties": {
          "rosterId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "timedIn": {
            "type": "boolean"
          },
          "timeIn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "timeOut": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "rosterId",
          "displayName",
          "timedIn",
          "timeIn",
          "timeOut"
        ]
      },
      "StudioTodayShowDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "showId": {
            "type": "string",
            "nullable": true
          },
          "scheduledFor": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "showName": {
            "type": "string",
            "nullable": true
          },
          "djs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "showId",
          "scheduledFor",
          "status",
          "showName",
          "djs"
        ]
      },
      "StudioTodayDto": {
        "type": "object",
        "properties": {
          "episode": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
