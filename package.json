{
  "name": "wildcat-radio-v2-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; exec next dev -p ${PORT:-3011} \"$@\"' --",
    "build": "next build",
    "start": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; exec next start -p ${PORT:-3011} \"$@\"' --",
    "lint": "eslint",
    "spec:sync": "cp ../wildcat-radio-v2-backend/apps/api/openapi.json openapi/openapi.json",
    "api:generate": "orval --config orval.config.ts",
    "api:refresh": "pnpm spec:sync && pnpm api:generate",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "pnpm run lint && pnpm run typecheck && pnpm run test:unit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "better-auth": "^1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.18.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "orval": "^8.39.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.21.1",
      "fast-uri": "~3.1.7",
      "js-yaml": "^4.3.2",
      "postcss": "^8.5.18",
      "socket.io-parser": "^4.2.7",
      "nanoid@<3.3.18": "^3.3.18",
      "sharp": "^0.35.5",
      "linkify-it": "^5.0.2",
      "browserslist": "^4.28.8",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "@next/eslint-plugin-next>fast-glob": "npm:tinyglobby@0.2.17",
      "better-auth>vitest": "4.1.11",
      "baseline-browser-mapping@<2.11.0": "^2.11.27",
      "markdown-it@<14.3.1": "^14.3.1",
      "source-map-js@<1.2.2": "^1.2.2"
    },
    "patchedDependencies": {
      "@next/eslint-plugin-next@16.3.6": "patches/@next__eslint-plugin-next@16.3.6.patch"
    }
  }
}
